# Copy to .env and adjust as needed. .env is git-ignored.
# SQL Server SA password used by docker-compose.yml and the appsettings.json
# docker connection string.
SA_PASSWORD=TaskManager@2026

# Host port mapped to Redis in docker-compose.yml. Change it if 6379 is already
# in use on the host, then point the API at the same port through the
# ConnectionStrings__Redis environment variable (default in appsettings.json is
# localhost:6379).
REDIS_PORT=6379

# Signing key for JWT access tokens. REQUIRED by the api service in
# docker-compose.yml - docker compose fails fast when it is missing or empty.
# Use a long random value in any non-local environment.
JWT_KEY=dev-only-signing-key-change-in-production-0123456789abcdef

# Host port exposed by the api service (container listens on 8080).
API_PORT=8080

# Allowed CORS origin for the frontend.
CORS_ORIGIN=http://localhost:5173

# Number of concurrent consumers the background worker runs (default 3).
WORKER_CONCURRENCY=3

# Auth rate limiting (per client IP, fixed window). These override the code
# defaults (10 requests / 60s) used by RateLimiting:Auth in appsettings.json.
# The Postman/Newman collection drives more than 10 auth calls (register,
# login, refresh) in under a minute, so raise the permit limit before running
# it, otherwise the API correctly answers 429 Too Many Requests. Set
# RATE_LIMIT_AUTH_PERMIT back to 10 (or lower) to exercise that 429 response.
RATE_LIMIT_AUTH_PERMIT=1000
RATE_LIMIT_AUTH_WINDOW=60
