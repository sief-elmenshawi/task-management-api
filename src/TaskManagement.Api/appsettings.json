    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=TaskManagement;User Id=sa;Password=TaskManager@2026;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": "localhost:6379"
  },
  "Cors": {
